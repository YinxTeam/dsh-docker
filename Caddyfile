{
	admin off
	auto_https off
	skip_install_trust
}

:{$PORT} {
	encode zstd gzip

	# 由入口脚本生成:启用认证时是 basic_auth 配置块,未启用时为空文件
	import /run/dsh-auth/auth.caddy

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# dsh 只信任回环地址的 Host,所以转发时统一改写为 127.0.0.1:3080;
	# 跨站写请求改在这里拦截并返回 403
	@unsafe_api {
		path /api /api/*
		expression `({http.request.header.Origin} != "" && {http.request.header.Origin} != "http://" + {http.request.hostport} && {http.request.header.Origin} != "https://" + {http.request.hostport}) || {http.request.header.Sec-Fetch-Site} == "cross-site"`
	}

	route @unsafe_api {
		respond "Forbidden" 403
	}

	route {
		reverse_proxy 127.0.0.1:3080 {
			header_up Host 127.0.0.1:3080
			header_up -Origin
			header_up -Authorization
		}
	}
}
