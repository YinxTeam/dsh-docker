{
	admin off
	auto_https off
	skip_install_trust
}

:{$PORT} {
	encode zstd gzip

	# Generated by the entrypoint: a basic_auth block, or empty when auth is off.
	import /run/dsh-auth/auth.caddy

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# dsh only trusts loopback hosts, so every request is presented to it as
	# 127.0.0.1:3080. Cross-site writes are rejected here instead.
	@unsafe_api {
		path /api /api/*
		expression `({http.request.header.Origin} != "" && {http.request.header.Origin} != "http://" + {http.request.hostport} && {http.request.header.Origin} != "https://" + {http.request.hostport}) || {http.request.header.Sec-Fetch-Site} == "cross-site"`
	}

	route @unsafe_api {
		respond "Forbidden" 403
	}

	route {
		reverse_proxy 127.0.0.1:3080 {
			header_up Host 127.0.0.1:3080
			header_up -Origin
			header_up -Authorization
		}
	}
}
