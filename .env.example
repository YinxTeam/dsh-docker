# 复制为 .env 后按需修改:cp .env.example .env

# 对外映射并监听的端口(需 >=1024)
PORT=8080

# basic auth:两项同时设置则启用,同时留空则不认证,只设一个会启动失败
# 用户名只能包含字母、数字、点、下划线、连字符
# DSH_AUTH_USERNAME=admin
# DSH_AUTH_PASSWORD=请改成强密码

# 默认工作目录(绝对路径);改到 /data/dsh 之外时需自行挂载该路径
# DSH_WORKSPACE=/data/dsh/home/workspace

# 使用的镜像;本地构建时改为 deepseek-harness:local
# DSH_IMAGE=ghcr.io/yinxteam/dsh-docker:latest
